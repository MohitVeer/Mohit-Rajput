# Server-side only (set in Netlify dashboard; never commit real values)
# Used by the Netlify functions. Not exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client-side values used by the authenticated admin dashboard.
# Access is restricted by Supabase Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend API key for contact-form delivery.
RESEND_API_KEY=
GITHUB_TOKEN=

# Optional search-engine verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
