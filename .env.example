# ── Server-side only (set in Netlify dashboard, NEVER commit real values) ──
# Used only inside netlify/functions/track.mts. Not exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Client-side (safe to expose, protected by Row Level Security) ──────────
# Used by the /admin dashboard to read aggregate data as an authenticated
# user. The anon key can only SELECT rows / call the fn_* analytics
# functions per the RLS policies and grants in
# supabase/migrations/0001_analytics_schema.sql and
# supabase/migrations/0002_visitor_intelligence.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Enables delivery of the contact form to rajput.mohit.veer@gmail.com via
# Resend (https://resend.com). Create the account with that same address.
RESEND_API_KEY=
GITHUB_TOKEN=

# Optional. Search engine verification tokens. Paste only the token (the content value
# of the verification meta tag) in the Netlify dashboard, then redeploy; the build adds
# the meta tag to every page. Google: Search Console > Add property > URL prefix > HTML tag.
# Bing: Webmaster Tools > Add site > HTML Meta Tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
