# ── Server-side only (set in Netlify dashboard, NEVER commit real values) ──
# Used only inside netlify/functions/track.mts. Not exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Enables the ISP/organization lookup in the analytics dashboard
# (sessions.isp_org). Sign up for a free token at https://ipinfo.io — the
# free tier covers 50k requests/month. If unset, ISP/org is simply left
# null everywhere; nothing else in tracking depends on it. The visitor's
# IP is used only in-memory for this one lookup call and is never written
# to the database.
IPINFO_TOKEN=

# ── Client-side (safe to expose, protected by Row Level Security) ──────────
# Used by the /admin dashboard to read aggregate data as an authenticated
# user. The anon key can only SELECT rows / call the fn_* analytics
# functions per the RLS policies and grants in
# supabase/migrations/0001_analytics_schema.sql and
# supabase/migrations/0002_visitor_intelligence.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
