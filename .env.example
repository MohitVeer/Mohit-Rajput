# ── Server-side only (set in Netlify dashboard, NEVER commit real values) ──
# Used only inside netlify/functions/track.mts. Not exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Client-side (safe to expose, protected by Row Level Security) ──────────
# Used by the future /admin dashboard to read aggregate data as an
# authenticated user. The anon key can only SELECT rows per the RLS
# policies in supabase/migrations/0001_analytics_schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
